# ============================================================
# Safar Tours — environment variables
# Copy to .env.local and fill in the values. Never commit .env.local.
#
# Supabase renamed its API keys. The legacy `anon` and `service_role` keys
# are deprecated and replaced by:
#   * publishable key  sb_publishable_...  -> browser / public code
#   * secret key       sb_secret_...       -> server only, never exposed
# https://supabase.com/docs/guides/api/api-keys
# ============================================================

# --- Supabase (required from Phase 1) ----------------------
# Project URL, Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key. Safe in the browser. Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key. SERVER ONLY. Never prefix it with NEXT_PUBLIC_ and never import
# it into a component. Supabase dashboard -> API Keys -> "sb_secret_..."
# Used only for: public form intake, cron jobs, admin scripts.
SUPABASE_SECRET_KEY=

# --- Database (legacy CRM request path and scripts) ---------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION pooler (port 5432) or the direct connection string.
# Prefer the session pooler URI for the request path. Keep the direct URI only
# as a fallback for tools/environments where the pooler is unavailable.
SUPABASE_DB_URL=

# NOTE: the current main branch still uses this connection for the legacy CRM
# request path. The planned Supabase Auth/RLS request-path migration will retire
# it after the live profile/auth cutover is verified.
DATABASE_URL=

# --- Enquiry notifications (optional) -----------------------
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=

# Google Sheets is now a BACKUP mirror of enquiries, not the primary store
# (Phase 2 writes to Supabase first). Server-only once Phase 2 lands — it is
# currently still NEXT_PUBLIC_ and therefore visible to the browser.
NEXT_PUBLIC_GOOGLE_SHEETS_ENDPOINT=

# --- CRM ----------------------------------------------------
CRM_SITE_URL=http://localhost:3000

# --- Site settings ------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=917001588581
# The canonical domain. Sitemap, canonicals and robots all derive from this.
# Phase 4 verifies this matches the live domain.
NEXT_PUBLIC_SITE_URL=https://safartour.in

# --- Removed in Phase 1 -------------------------------------
# CRM_SECRET_KEY and CRM_DOCUMENTS_DIR are no longer used.
# Documents move to a private Supabase Storage bucket (migration 006).
